# Create a dictionary
student = {
    "name": "Rahul",
    "age": 20,
    "course": "Python"
}

print("Original Dictionary:", student)
student["city"] = "Pune"
print("After adding city:", student)
student.pop("city")
print("After removing city:", student)
del student["course"]
print("After deleting course:", student)
student.update({
    "course": "Computer Science",
    "marks": 85
})
print("After adding multiple items:", student)
print("Keys:", student.keys())
print("Values:", student.values())

